# Multi-Cloud Infrastructure Intelligence MCP Server
# Environment Variables Template
#
# Copy this file to .env and fill in your credentials
# Never commit .env to version control!

# ============================================================================
# AWS Credentials
# ============================================================================
# Option 1: Use AWS CLI credentials (recommended)
# Run: aws configure
#
# Option 2: Set environment variables
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# Azure Credentials
# ============================================================================
# Option 1: Use Azure CLI (recommended)
# Run: az login
#
# Option 2: Set environment variables
AZURE_SUBSCRIPTION_ID=your_subscription_id_here
# AZURE_TENANT_ID=your_tenant_id_here
# AZURE_CLIENT_ID=your_client_id_here
# AZURE_CLIENT_SECRET=your_client_secret_here

# ============================================================================
# GCP Credentials
# ============================================================================
# Option 1: Use Application Default Credentials (recommended)
# Run: gcloud auth application-default login
#
# Option 2: Set service account key file path
GCP_PROJECT_ID=your_project_id_here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================================================
# Server Configuration
# ============================================================================
# MCP_SERVER_PORT=8000
# MCP_LOG_LEVEL=INFO
# MCP_CACHE_TTL=3600