# PESAMultiCloudIntel — WebApp Backend Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control!

# ============================================================================
# ICA Langflow Workflow API
# ============================================================================

# Full run URL — use the Langflow host and your workflow ID
# Format: https://langflow.servicesessentials.ibm.com/api/v1/run/<workflow-id>
#
# Your workflow ID comes from the MCP server config:
#   "https://langflow.servicesessentials.ibm.com/api/v1/mcp/project/<project-id>/streamable"
#   Replace "mcp/project/<project-id>/streamable" with "run/<workflow-id>"
#   The workflow ID is the Flow ID visible in the Langflow UI.
ICA_WORKFLOW_URL=https://langflow.servicesessentials.ibm.com/api/v1/run/your-workflow-id-here

# API key — use the x-api-key value from your MCP server configuration
# In your MCP config JSON this is the value after "--headers x-api-key"
ICA_API_KEY=your-x-api-key-here

# ============================================================================
# Backend Server Configuration
# ============================================================================

# Port the FastAPI server listens on (default: 8001)
# Note: mcp_server.py uses port 8000 — do not use 8000 here
BACKEND_PORT=8001

# Comma-separated list of allowed CORS origins
# Use * to allow all origins during local development
CORS_ORIGINS=*
